# ---------------------------------------------------------------------------
# API quản lý tài sản — biến môi trường
# Copy thành api/.env rồi điền giá trị. KHÔNG BAO GIỜ commit file .env.
# ---------------------------------------------------------------------------

# Cổng API (reverse proxy của aaPanel trỏ vào cổng này)
PORT=3001
NODE_ENV=development

# --- Cơ sở dữ liệu -------------------------------------------------------
# MySQL 8:
DATABASE_URL="mysql://USER:PASSWORD@127.0.0.1:3306/ltl_taisan"
# Đổi sang PostgreSQL: sửa provider trong prisma/schema.prisma thành
# "postgresql" rồi dùng dạng:
# DATABASE_URL="postgresql://USER:PASSWORD@127.0.0.1:5432/ltl_taisan?schema=public"

# --- JWT -----------------------------------------------------------------
# Sinh khoá: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Ảnh -----------------------------------------------------------------
# Thư mục lưu ảnh trên VPS (chia thư mục theo năm/tháng)
UPLOAD_DIR=./uploads
# Giới hạn mỗi ảnh (byte) — 10MB
UPLOAD_MAX_BYTES=10485760
# Cạnh dài nhất sau khi nén (px)
UPLOAD_MAX_EDGE=1600

# Tài liệu wiki (PDF/Word/Excel) — to hơn ảnh. File lớn hơn mức này thì dán
# link Drive vào mục "Liên kết ngoài" thay vì tải lên.
UPLOAD_DOC_MAX_BYTES=26214400

# --- CORS ----------------------------------------------------------------
# Danh sách origin được phép, cách nhau bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173

# --- Khoá vị trí cho vai trò KHO ----------------------------------------
# Bán kính mặc định (mét) khi điểm kho chưa cấu hình riêng
GPS_DEFAULT_RADIUS_M=150

# --- Tài khoản quản trị khởi tạo (dùng cho lệnh seed) -------------------
SEED_ADMIN_EMAIL=admin@learntoleap.local
SEED_ADMIN_PASSWORD=
