# =============================================================================
# LtL TeachOps — mẫu biến môi trường.
# Sao chép thành .env trên VPS rồi điền giá trị thật:  cp .env.example .env
# TUYỆT ĐỐI không commit file .env.
# =============================================================================

# ---- Cơ sở dữ liệu -----------------------------------------------------------
POSTGRES_DB=teachops
POSTGRES_USER=teachops
# Sinh chuỗi ngẫu nhiên:  openssl rand -base64 32
POSTGRES_PASSWORD=doi_mat_khau_nay

# ---- API ---------------------------------------------------------------------
NODE_ENV=production
PORT=3000
# Sinh khoá:  openssl rand -base64 48
JWT_SECRET=doi_khoa_nay_bang_chuoi_ngau_nhien_48_ky_tu
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL_DAYS=30

# Tên miền frontend được phép gọi API (phân tách bằng dấu phẩy).
# Bắt buộc khai đúng, nếu không trình duyệt sẽ chặn vì CORS.
CORS_ORIGINS=https://teacher.learntoleap.vn,https://ltl-teachops.vercel.app,http://localhost:5173

# Thư mục lưu tệp bên trong container (đã ánh xạ ra volume ./data/uploads)
UPLOAD_DIR=/data/uploads
MAX_UPLOAD_MB=15
# Video minh chứng (điểm danh, báo hỏng, góp ý, học liệu video). Nhớ nâng
# client_max_body_size của Nginx cho tên miền API lên cao hơn con số này.
MAX_VIDEO_MB=100

# ---- Tài khoản Admin đầu tiên (chỉ dùng ở lần khởi động đầu) ------------------
SEED_ADMIN_EMAIL=admin@learntoleap.vn
SEED_ADMIN_PASSWORD=doi_ngay_sau_khi_dang_nhap
SEED_ADMIN_NAME=Quản trị hệ thống

# ---- Email (gửi mật khẩu tạm & đặt lại mật khẩu) -----------------------------
# Bỏ trống SMTP_HOST ⇒ hệ thống KHÔNG gửi email, mật khẩu tạm hiện thẳng
# trên màn hình Admin sau khi tạo tài khoản (phù hợp lúc chạy thử).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="LtL TeachOps <no-reply@learntoleap.vn>"
APP_PUBLIC_URL=https://teacher.learntoleap.vn
# Địa chỉ công khai của API — dùng làm redirect URI khi kết nối Google Drive
API_PUBLIC_URL=https://teachops-api.learntoleap.vn

# ---- Google Drive (kho ảnh/video) ---------------------------------------------
# Cách khuyên dùng: Admin vào app → Lưu trữ Drive → làm theo 3 bước (không cần sửa file này).
# Các biến GOOGLE_* dưới đây chỉ là cách cấu hình dự phòng (chạy `npm run drive:auth`).
# CẢNH BÁO: refresh token cho phép ghi vào Drive của tài khoản quản trị — giữ kín.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_DRIVE_REFRESH_TOKEN=
# Bao lâu quét đẩy một lượt (phút)
DRIVE_SYNC_MINUTES=5
# Giữ bản gốc ảnh/video trên VPS bao nhiêu ngày sau khi đã lên Drive (Admin đổi được trong app)
DRIVE_KEEP_LOCAL_DAYS=7

# ---- Caddy (TLS tự động) — CHỈ cần nếu chạy: docker compose --profile caddy up -d
# VPS đã có panel quản trị lo sẵn Nginx + SSL (aaPanel, bt-panel…) thì bỏ qua 2 dòng này.
API_DOMAIN=teachops-api.learntoleap.vn
ACME_EMAIL=it@learntoleap.vn
